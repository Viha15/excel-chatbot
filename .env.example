# LLM provider: ollama | azure | openai
LLM_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# How long Ollama keeps the model loaded after the API warms it up at startup
OLLAMA_KEEP_ALIVE=30m

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speed / cost
# Phrase answers with a second LLM call (true) or a code template (false).
# Leave empty for the default: false on ollama, true on azure/openai.
ANSWER_WITH_LLM=
# Example rows per sheet shown to the LLM when planning
PROFILE_SAMPLE_ROWS=0
# Constrain the plan to a JSON schema (structured output). Off by default: with small
# local models it made them fill every optional field with placeholders. Try it with
# larger models, and measure with: uv run python -m eval.run_examples
STRUCTURED_OUTPUT=false

# Limits
# Per LLM call. A question makes 1-2 calls (+1 if the first plan is invalid).
LLM_TIMEOUT_SECONDS=180
MAX_UPLOAD_MB=50
# Guardrails
MAX_UNCOMPRESSED_MB=300
RATE_LIMIT_PER_MINUTE=30
MAX_RESULT_ROWS=200
MAX_LLM_ROWS=20
MAX_DISTINCT_VALUES=25
